# =============================================================================
# backend/.env.example — variables del backend ACADEMIX 2.0
#
# USO:  cp backend/.env.example backend/.env   y rellena los secretos.
#       (O genera todo con:  bash scripts/init-secrets.sh --demo )
#       NUNCA subas el `.env` real al repositorio.
#
# BASE DE DATOS NATIVA: el proyecto se conecta al MySQL/MariaDB instalado en la
# máquina anfitriona, NO a un contenedor.
#   · desarrollo local (backend en tu máquina):  DB_HOST=127.0.0.1
#   · backend en Docker + MySQL en el host:      DB_HOST=host.docker.internal
#     (docker-compose.yml ya lo sobreescribe a host.docker.internal)
# =============================================================================

# --- Entorno -----------------------------------------------------------------
NODE_ENV=development
PORT=5050
HOST=0.0.0.0
LOG_LEVEL=debug

# --- Base de datos NATIVA ----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ADMIN
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=academix_v2
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000

# --- Seguridad / JWT ---------------------------------------------------------
# Genera cada secreto con:  openssl rand -hex 32   (64 caracteres hex)
# En NODE_ENV=production el arranque ABORTA si miden menos de 32 caracteres.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Clave de cifrado de campos sensibles (32 bytes hex = 64 caracteres)
ENCRYPTION_KEY=

# --- Cookies de sesión -------------------------------------------------------
# 'true' EXIGE HTTPS: un navegador descarta las cookies `Secure` recibidas por
# HTTP y el login parecería funcionar sin dejar entrar. El stack Docker sirve
# nginx por HTTP, así que ahí debe quedar en 'false'.
COOKIE_SECURE=false
ACCESS_TOKEN_COOKIE=accessToken
REFRESH_TOKEN_COOKIE=refreshToken
ACCESS_TOKEN_COOKIE_MAX_AGE=900000
REFRESH_TOKEN_COOKIE_MAX_AGE=604800000

# --- CORS --------------------------------------------------------------------
# Lista separada por comas. En producción debe ser el dominio real (HTTPS).
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# --- Límites de peticiones ---------------------------------------------------
# RATE_LIMIT_MAX: peticiones por ventana para la API general.
# AUTH_RATE_LIMIT_MAX: intentos de login/registro por ventana y por cuenta+IP.
#   Mantener BAJO (p. ej. 10) para frenar ataques de fuerza bruta.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# --- Autenticación de dos factores -------------------------------------------
TWO_FACTOR_ENABLED=false
TWO_FACTOR_ISSUER=ACADEMIX
TWO_FACTOR_PERIOD=30

# --- Archivos ----------------------------------------------------------------
JSON_BODY_LIMIT=1mb
UPLOAD_MAX_SIZE_BYTES=10485760
MAX_FILE_SIZE_BYTES=10485760

# --- Operación ---------------------------------------------------------------
SHUTDOWN_TIMEOUT_MS=10000
AUDIT_RETENTION_DAYS=730
# SALTOS de proxy de confianza (número, NO booleano):
#   0 -> la API está expuesta directamente (Express ignora X-Forwarded-For)
#   1 -> hay EXACTAMENTE un reverse-proxy delante (nginx en docker-compose)
# SEGURIDAD: nunca poner `true`; permitiría falsificar la IP y saltarse los
# límites de peticiones.
TRUST_PROXY=0

# --- Semillas ----------------------------------------------------------------
# false en producción: con false los seeds NO crean las cuentas demo.
SEED_ALLOW_IN_PRODUCTION=false
