# -----------------------------------------------------------------------------
# frontend/.env.production.example — build de producción.
# Copiar a frontend/.env.production y ajustar antes de  npm run build.
#
# Con Docker NO se usa este archivo: el Dockerfile recibe VITE_API_URL como
# build-arg (docker-compose.yml pasa /api) y nginx resuelve el proxy /api.
# -----------------------------------------------------------------------------

# En un despliegue servido por nginx, la SPA y la API comparten origen:
# usa una ruta RELATIVA para que el proxy de nginx resuelva el backend.
VITE_API_URL=/api

VITE_APP_NAME=ACADEMIX 2.0
VITE_DEFAULT_LANGUAGE=en
