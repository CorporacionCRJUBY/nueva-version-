# -----------------------------------------------------------------------------
# backend/.env.production.example — despliegue REAL. Copiar a
# backend/.env.production y rellenar con secretos propios:
#     openssl rand -hex 32
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# MySQL NATIVO del servidor.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ADMIN
DB_PASSWORD=J-admin-crfenix55
DB_NAME=academix_v2

JWT_SECRET=<openssl rand -hex 32>
JWT_REFRESH_SECRET=<openssl rand -hex 32>
ENCRYPTION_KEY=<openssl rand -hex 32>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Obligatorio en producción (el arranque ABORTA si falta o es '*')
CORS_ORIGIN=https://academix.tu-dominio.edu

# Obligatorio en producción servida por HTTPS. Si sirves por HTTP (p. ej. la
# demo con nginx:80) DEBE quedar en 'false', o el navegador descartará la
# cookie de sesión y el login no dejará entrar.
COOKIE_SECURE=true

# Saltos de proxy de confianza (0 = expuesto directamente, 1 = detrás de nginx)
TRUST_PROXY=1

# NUNCA activar en producción: mantiene bloqueadas las cuentas demo del seed
SEED_ALLOW_IN_PRODUCTION=false
