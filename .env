# FILE: .env.example — variables que consume docker-compose.yml
#
# Copia a `.env` y rellena los valores (o genera todo automáticamente con
# `bash scripts/init-secrets.sh`).
#
# ⚠️ Compose SOLO sustituye ${VAR} para las variables escritas en el propio
# `docker-compose.yml`. El backend NO lee este archivo: sus variables llegan
# por `env_file: ./backend/.env`. Por eso los secretos de firma (JWT_*,
# ENCRYPTION_KEY) viven en `backend/.env.example`, no aquí.
#
# La BASE DE DATOS es un MySQL NATIVO del anfitrión: este archivo solo lleva
# sus credenciales, no arranca ningún contenedor de base de datos.

# --- Base de datos nativa ----------------------------------------------------
# Host del servidor MySQL/MariaDB VISTO DESDE EL CONTENEDOR del backend.
#   host.docker.internal -> la máquina anfitriona (lo resuelve extra_hosts)
#   172.17.0.1            -> alternativa en Linux si lo anterior fallara
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=ADMIN
DB_PASSWORD=J-admin-crfenix55
DB_NAME=academix_v2

# --- Aplicación --------------------------------------------------------------
# Origen permitido por CORS (URL pública del frontend).
CORS_ORIGIN=http://localhost:8080
TZ=America/Costa_Rica

# --- Cookies de sesión -------------------------------------------------------
# 'false' -> permite trabajar sobre HTTP local (el stack sirve nginx por HTTP).
#            Un navegador DESCARTA las cookies `Secure` recibidas por HTTP, así
#            que con 'true' sobre HTTP el login devuelve 200 y no entra.
# 'true'  -> obligatorio en un despliegue real servido por HTTPS.
COOKIE_SECURE=false

# --- Semillas ----------------------------------------------------------------
# 'false' (recomendado): NO crea las cuentas demo cuando NODE_ENV=production.
# 'true': solo para un entorno de demostración.
SEED_ALLOW_IN_PRODUCTION=false
