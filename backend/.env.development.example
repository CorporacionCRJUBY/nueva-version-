# -----------------------------------------------------------------------------
# backend/.env.development.example — entorno de DESARROLLO local (sin Docker).
# Copiar a backend/.env.development (o a backend/.env) y rellenar.
#
#   cd backend && npm install && npm run migrate && npm run seed && npm start
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5050
HOST=0.0.0.0
LOG_LEVEL=debug

# Base de datos NATIVA: MySQL/MariaDB instalado en esta misma máquina.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ADMIN
DB_PASSWORD=J-admin-crfenix55
DB_NAME=academix_v2
DB_POOL_MIN=2
DB_POOL_MAX=10

# Secretos: generar con  openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# En desarrollo se sirve por HTTP, así que la cookie NO puede ser Secure.
COOKIE_SECURE=false

# Orígenes permitidos: el servidor de desarrollo de Vite y el de Docker.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# 0 = la API está expuesta directamente (sin proxy delante).
TRUST_PROXY=0

# Los seeds SÍ crean cuentas demo fuera de producción.
SEED_ALLOW_IN_PRODUCTION=false
