# -----------------------------------------------------------------------------
# backend/.env.test.example — entorno de PRUEBAS (Jest / CI).
# Copiar a backend/.env.test y rellenar los secretos con:  openssl rand -hex 32
# -----------------------------------------------------------------------------
NODE_ENV=test
PORT=5050
HOST=0.0.0.0
LOG_LEVEL=error

# Base de datos NATIVA: MySQL/MariaDB instalado en esta misma máquina.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ADMIN
DB_PASSWORD=J-admin-crfenix55
DB_NAME=academix_v2
DB_POOL_MIN=1
DB_POOL_MAX=5

# Secretos: generar con  openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# En pruebas se sirve por HTTP, así que la cookie NO puede ser Secure.
COOKIE_SECURE=false

# Orígenes permitidos en pruebas.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# 0 = la API está expuesta directamente (sin proxy delante).
TRUST_PROXY=0

# Los seeds NO crean cuentas demo en pruebas.
SEED_ALLOW_IN_PRODUCTION=false
