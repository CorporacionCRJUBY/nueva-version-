# FILE: frontend/.env.example
# Copia este archivo a .env y ajusta los valores.
# En desarrollo, VITE_API_URL apunta al backend local.
# En Docker/nginx, el proxy /api resuelve al backend, así que usa /api.

# URL base de la API (en desarrollo: http://localhost:5000/api)
VITE_API_URL=http://localhost:5000/api

# Nombre de la aplicación
VITE_APP_NAME=ACADEMIX 2.0

# Idioma por defecto (en | es)
VITE_DEFAULT_LANGUAGE=en
